# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# Nemotron / NVIDIA (required for live LLM path)
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=mistralai/mistral-nemotron

# GitHub (optional for public repos; required for private)
GITHUB_TOKEN=

# Exa (optional external evidence — disabled by default)
EXA_API_KEY=
EXA_ENABLED=false

# Agent behaviour
DEMO_MODE=true
ALLOW_LLM_FALLBACK=true
PORT=8787
