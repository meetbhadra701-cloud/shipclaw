# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# Nemotron / NVIDIA (required for live LLM path)
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# GitHub (optional; improves public API limits. Private repositories are not supported)
GITHUB_TOKEN=

# Exa (optional external evidence — disabled by default)
EXA_API_KEY=
ENABLE_EXA=false
EXA_ENABLED=false
EXA_TIMEOUT_MS=8000
EXA_MAX_SEARCHES_PER_RUN=3

# Agent behaviour
DEMO_MODE=false
ALLOW_LLM_FALLBACK=true
PORT=8787

# Optional persistent root for BOTH shipclaw.sqlite and runs/.
# Unset/empty preserves local data/shipclaw.sqlite and runs/.
SHIPCLAW_DATA_DIR=
# Render sets PORT automatically. Use NODE_ENV=production on the service.
