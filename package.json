{
  "name": "shipclaw",
  "version": "0.1.0",
  "description": "Bounded autonomous release-readiness agent — ShipClaw hackathon MVP",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --host 0.0.0.0\"",
    "server": "node node_modules/tsx/dist/cli.mjs src/server/index.ts",
    "agent:run": "node node_modules/tsx/dist/cli.mjs src/agent/run.ts",
    "migrate": "node node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "seed:demo": "node node_modules/tsx/dist/cli.mjs scripts/seed-demo.ts",
    "smoke": "node node_modules/tsx/dist/cli.mjs scripts/smoke.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "node node_modules/vite/bin/vite.js build && node node_modules/typescript/bin/tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "nanoid": "^5.0.7",
    "openai": "^4.47.1",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "simple-git": "^3.24.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
